{
  "name": "dsh-login-gateway",
  "version": "0.1.2-rc.1",
  "description": "DeepSeek Harness 登录门卫插件：为 dsh Web UI 提供外部访问入口 + 用户名密码登录验证",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "dsh-login-gateway-hash": "bin/hash.js"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runfali/dsh-login-gateway.git"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-alpha.3 <0.2.0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "immediately": true
    }
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "auth",
    "gateway"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}